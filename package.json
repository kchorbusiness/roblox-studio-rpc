{
  "name": "roblox-studio-rpc",
  "version": "1.0.0",
  "description": "Roblox Studio Discord Rich Presence",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.robloxstudio.rpc",
    "productName": "Roblox Studio RPC",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "bridge.js",
      "assets/**"
    ]
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
